---
import Prose from "@/components/posts/Prose.astro";
import Page from "@/components/shared/Page.astro";
import { Button } from "@/components/ui/button";
import { Home } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import Image from "astro/components/Image.astro";
import { render, type CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<'posts'>
};

const { post } = Astro.props;
const { Content } = await render(post);
---
<!-- Top bar -->
<div class="flex justify-start items-center sticky top-0 bg-muted/10 backdrop-blur-md">
  <a href="/" aria-label="Home">
    <Button className="flex-1" size={"icon-lg"}>
      <HugeiconsIcon icon={Home}/>
    </Button>
  </a>
  <span class="px-4 text-xs text-muted-foreground font-mono line-clamp-1">Post &#183; {post.data.title}</span>
</div>
<!-- Content -->
<Page>
  <div class="flex flex-col gap-4 max-w-3xl mx-auto">
    <Image 
      class="aspect-video object-cover"
      src={post.data.image}
      alt={post.data.imageAlt}
      inferSize
    />
    <div>
      <Prose>
        <Content />
      </Prose>
    </div>
  </div>
  <!-- Footer -->
  <div class="flex flex-col mt-10 items-center p-4">
    <p class="text-sm text-muted-foreground">Authored by {post.data.author} on {post.data.pubDate.toLocaleDateString()}</p>
  </div>
</Page>