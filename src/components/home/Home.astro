---
import Post from "@/components/home/PostCard.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts")
---

<div class="flex flex-row sm:justify-between justify-center mb-8">
  <h1 class="text-3xl">All Posts</h1>
</div>
<div
  class="grid gap-4 xl:grid-cols-4 lg:grid-cols-3 sm:grid-cols-2 grid-cols-1"
>
  {posts.map(
    (post) => (
      <Post 
        post={post}
      />
    )
  )}
</div>
