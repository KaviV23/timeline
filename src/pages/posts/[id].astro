---
import Page from "@/components/shared/Page.astro";
import { Button } from "@/components/ui/button";
import Layout from "@/layouts/Layout.astro";
import { Home } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import Image from "astro/components/Image.astro";
import { getCollection, getEntry, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { id: post.id },
  }));
}

const { id } = Astro.params;
const post = await getEntry("posts", id);

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);

---
<Layout title={post.data.title}>
  <!-- Top bar -->
  <div class="flex justify-start items-center gap-4 sticky top-0 backdrop-blur-sm">
    <a href="/">
      <Button className="flex-1" size={"icon-lg"}>
        <HugeiconsIcon icon={Home}/>
      </Button>
    </a>
    <span class="text-xs text-muted-foreground font-mono">Timeline</span>
  </div>
  <!-- Content -->
  <Page>
    <!-- Title and date -->
    <div class="flex flex-col sm:flex-row justify-between sm:items-end items-center mb-8 sm:gap-4 gap-2">
      <h1 class="flex-1 text-3xl">{post.data.title}</h1>
      <span class="text-xs text-muted-foreground">{post.data.author} &#183; {post.data.pubDate.toLocaleDateString()}</span>
    </div>
    <!-- Content -->
    <div class="flex flex-col gap-4 max-w-5xl mx-auto">
      <Image 
        src={post.data.image}
        alt={post.data.imageAlt}
      />
      <div>
        <Content />
      </div>
    </div>
  </Page>
</Layout>